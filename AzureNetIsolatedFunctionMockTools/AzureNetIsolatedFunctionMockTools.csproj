<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<Title>Azure .NET Isolated Function Mock Tools</Title>
	<IsPackable>true</IsPackable>
	<Version>0.1.0</Version>
    <Authors>StatisticsFinland</Authors>
    <Company>StatisticsFinland</Company>
    <Description>Tools for mocking Azure .NET Isolated functions.</Description>
    <PackageTags>azure; .net; isolated; function; test; mock</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.0.0" />
  </ItemGroup>

</Project>
